@model IReadOnlyList<ParkGuide>
@{ ViewData["Title"] = "Disney World"; }
<main class="app-shell park-hub">
  <section class="park-hub-hero">
    <div><p class="eyebrow">WALT DISNEY WORLD · FLORIDA</p><h1>Choose your Disney day.</h1><p>Explore all four Walt Disney World parks, see visitor ratings for favorite experiences, and open a live park map when it is time to move.</p></div>
    <a class="hero-primary" href="/map/maps">Compare live wait times</a>
  </section>
  <section class="park-hub-grid" aria-label="Disney park guides">
  @foreach (var park in Model)
  {
    <article class="park-hub-card">
      <img src="@park.Image" alt="@park.Name" />
      <div class="park-hub-card-body"><p>@park.Tagline</p><h2>@park.Name</h2><span>@park.Description</span><div><a href="/disney-selection/@park.Id">Explore guide</a><a class="park-hub-map-link" href="@park.MapRoute">Live map</a></div></div>
    </article>
  }
  </section>
</main>

<style>
  html:has(.park-hub),body:has(.park-hub){margin:0;min-height:100%;background:#fffaf3}
  .park-hub{box-sizing:border-box;max-width:1280px;margin:0 auto;padding:clamp(1.1rem,4vw,3.5rem);font-family:Karla,Arial,sans-serif;color:#132238}
  .park-hub-hero{position:relative;isolation:isolate;display:flex;min-height:20rem;align-items:flex-end;justify-content:space-between;gap:2rem;overflow:hidden;border-radius:1.45rem;padding:clamp(2rem,6vw,4.7rem);background:linear-gradient(115deg,#102a43,#225d90 62%,#f5bd61);color:#fff;box-shadow:0 18px 42px rgba(16,42,67,.18)}
  .park-hub-hero::after{position:absolute;z-index:-1;right:-4rem;top:-4rem;width:25rem;height:25rem;border:3rem solid rgba(255,255,255,.1);border-radius:50%;content:""}.park-hub-hero>div{max-width:44rem}.park-hub .eyebrow{margin:0;color:#ffd47f;font-size:.76rem;font-weight:800;letter-spacing:.15em}.park-hub-hero h1{margin:.8rem 0 1rem;font-size:clamp(2.75rem,5.5vw,5rem);font-weight:800;line-height:.94;letter-spacing:-.065em}.park-hub-hero p:not(.eyebrow){max-width:41rem;margin:0;color:#eef5fa;font-size:1.06rem;line-height:1.62}.park-hub .hero-primary{display:inline-flex;flex:none;align-items:center;justify-content:center;border-radius:.72rem;background:#f6bd60;padding:.92rem 1.15rem;color:#132238;font-size:.92rem;font-weight:800;text-decoration:none;box-shadow:0 8px 18px rgba(0,0,0,.15);transition:transform .16s}.park-hub .hero-primary:hover{transform:translateY(-2px)}
  .park-hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem;margin-top:1.35rem}.park-hub-card{display:grid;grid-template-columns:minmax(10rem,.78fr) 1.22fr;min-height:16rem;overflow:hidden;border:1px solid #e2e8f0;border-radius:1.1rem;background:#fff;box-shadow:0 10px 25px rgba(18,34,56,.09);transition:transform .18s,box-shadow .18s}.park-hub-card:hover{transform:translateY(-4px);box-shadow:0 18px 34px rgba(18,34,56,.15)}.park-hub-card>img{width:100%;height:100%;min-height:16rem;object-fit:cover;background:#e5edf6}.park-hub-card-body{display:flex;flex-direction:column;align-items:flex-start;padding:1.5rem}.park-hub-card-body>p{margin:0;color:#235b91;font-size:.72rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.park-hub-card h2{margin:.55rem 0 0;font-size:clamp(1.45rem,2.3vw,2.1rem);line-height:1.02;letter-spacing:-.045em}.park-hub-card-body>span{margin-top:.7rem;color:#5b6b7e;font-size:.9rem;line-height:1.55}.park-hub-card-body>div{display:flex;gap:.55rem;flex-wrap:wrap;margin-top:auto;padding-top:1.2rem}.park-hub-card-body a{display:inline-flex;align-items:center;justify-content:center;border-radius:.52rem;background:#173f67;padding:.58rem .7rem;color:#fff;font-size:.78rem;font-weight:800;text-decoration:none}.park-hub-card-body a:hover{background:#235b91}.park-hub-card-body .park-hub-map-link{border:1px solid #d5e0eb;background:#fff;color:#1b4f7f}
  @@media(max-width:900px){.park-hub-grid{grid-template-columns:1fr}.park-hub-hero{align-items:flex-start;flex-direction:column;min-height:0}.park-hub .hero-primary{margin-top:.3rem}}@@media(max-width:520px){.park-hub{padding:1rem}.park-hub-hero{border-radius:1rem;padding:2rem 1.35rem}.park-hub-hero h1{font-size:2.8rem}.park-hub-card{grid-template-columns:1fr}.park-hub-card>img{height:12rem;min-height:0}.park-hub-card-body{padding:1.25rem}}
</style>

@model IReadOnlyList<ParkGuide>
@{ ViewData["Title"] = "Disney World"; }
<main class="app-shell park-hub">
  <section class="park-hub-hero">
    <div><p class="eyebrow">WALT DISNEY WORLD · FLORIDA</p><h1>Choose your Disney day.</h1><p>Explore all four Walt Disney World parks, see visitor ratings for favorite experiences, and open a live park map when it is time to move.</p></div>
    <a class="hero-primary" href="/map/maps">Compare live wait times</a>
  </section>
  <section class="park-hub-grid" aria-label="Disney park guides">
  @foreach (var park in Model)
  {
    <article class="park-hub-card">
      <img src="@park.Image" alt="@park.Name" />
      <div class="park-hub-card-body"><p>@park.Tagline</p><h2>@park.Name</h2><span>@park.Description</span><div><a href="/disney-selection/@park.Id">Explore guide</a><a class="park-hub-map-link" href="@park.MapRoute">Live map</a></div></div>
    </article>
  }
  </section>
</main>

@model ParkSelectionViewModel
@{ ViewData["Title"] = Model.Park.Name; var averages = Model.Averages; }
<main class="app-shell">
  <section class="selection-hero">
    <div>
      <p class="eyebrow">WALT DISNEY WORLD · FLORIDA</p>
      <h1>Plan your @Model.Park.Name day.</h1>
      <p>@Model.Park.Description Compare visitor ratings, explore every corner of the park, and check the live wait-time board when you are ready to choose your next experience.</p>
      <div class="hero-actions" style="margin-top:1.5rem"><a href="@Model.Park.MapRoute" class="hero-primary">Open live park map</a><a href="/disney-selection-homepage" class="hero-secondary">Browse all parks</a></div>
    </div>
    <img src="@Model.Park.Image" alt="@Model.Park.Name at Walt Disney World" />
  </section>
  @foreach (var group in Model.Attractions.GroupBy(x => x.Category))
  {
    <section class="catalog-section">
      <div class="catalog-section-heading"><h2>@group.Key</h2><span class="catalog-count">@group.Count() places to explore</span></div>
      <div class="attraction-grid">
      @foreach (var attraction in group)
      {
        <a href="/page/@attraction.Id" class="attraction-card"><figure><img src="@attraction.Image" alt="@attraction.Name" /></figure><div class="attraction-card-body"><h3>@attraction.Name</h3><p>@attraction.Description</p><span class="attraction-rating">@(averages.TryGetValue(attraction.Id, out var average) ? $"★ {average:F1} visitor rating" : "New — no ratings yet")</span></div></a>
      }
      </div>
    </section>
  }
</main>

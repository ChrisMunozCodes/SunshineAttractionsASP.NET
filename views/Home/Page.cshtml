@model PageViewModel
@{ ViewData["Title"] = Model.Attraction.Name; var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<main class="max-w-6xl mx-auto p-5"><section class="card bg-base-100 shadow-xl"><figure class="max-h-96"><img class="w-full object-cover" src="@Model.Attraction.Image" alt="@Model.Attraction.Name" /></figure><div class="card-body"><h1 class="text-4xl">@Model.Attraction.Name</h1><p class="text-xl">@Model.Attraction.Description</p><div>@foreach (var tag in Model.Attraction.Tags) { <span class="badge badge-secondary badge-outline mr-2">@tag</span> }</div><p class="font-bold">@(Model.AverageRating > 0 ? $"Rating: {Model.AverageRating:F1}/5" : "No ratings yet")</p></div></section>
  @if (User.Identity?.IsAuthenticated == true && !Model.HasReviewed) { <section class="card bg-secondaryButton shadow-xl mt-6"><div class="card-body"><h2 class="text-2xl">Leave a review</h2><form action="/review/createReview" method="post" class="grid gap-3"><input type="hidden" name="pageName" value="@Model.Attraction.Id" /><select name="rating" class="select select-bordered" required><option value="">Select rating</option>@for (var star = 1; star <= 5; star++) { <option value="@star">@star star@(star == 1 ? "" : "s")</option> }</select><textarea name="desc" class="textarea textarea-bordered" maxlength="1000" required placeholder="Tell visitors what you thought"></textarea><p class="alert">Image uploads are not currently supported.</p><button class="btn bg-primaryButton text-black">Submit review</button></form></div></section> }
  else if (User.Identity?.IsAuthenticated != true) { <p class="alert mt-6">Please <a class="link" href="/login">log in</a> to leave a review.</p> }
  else { <p class="alert mt-6">You have already reviewed this attraction.</p> }
  <nav class="tabs tabs-boxed mt-8"><a class="tab @(Model.Filter == "all" ? "tab-active" : "")" href="?filter=all">All</a><a class="tab @(Model.Filter == "your" ? "tab-active" : "")" href="?filter=your">Your reviews</a><a class="tab" href="?filter=highest-rated">Highest rated</a><a class="tab" href="?filter=most-critical">Most critical</a></nav>
  <section class="mt-5 space-y-5">@foreach (var card in Model.Reviews) { <article class="card bg-base-100 shadow"><div class="card-body"><div class="flex items-center gap-3"><div class="avatar"><div class="w-10 rounded-full"><img src="@card.User.ProfilePic" alt="@card.User.UserName" /></div></div><h2 class="text-xl">@card.User.UserName</h2><span class="ml-auto font-bold">@card.Review.Rating / 5</span></div><p>@card.Review.Description</p>@if (card.Review.Images.Count > 0) { <div class="grid grid-cols-2 md:grid-cols-4 gap-2">@foreach (var image in card.Review.Images) { <img class="w-full h-36 object-cover rounded" src="@image" alt="Review image" /> }</div> }<div class="flex gap-3 items-center"><button class="btn btn-sm" onclick="toggleReviewLike('@card.Review.Id', this)">♥ <span>@card.Review.Likes</span></button><span>@card.Comments.Count comment(s)</span></div><div class="border-t pt-3 space-y-3">@foreach (var comment in card.Comments) { <div class="bg-gray-50 p-3 rounded"><strong>@comment.User.UserName</strong><p>@comment.Comment.Description</p><button class="btn btn-xs" onclick="toggleComment('@comment.Comment.Id', true, this)">♥ <span>@comment.Comment.Likes</span></button><button class="btn btn-xs" onclick="toggleComment('@comment.Comment.Id', false, this)">👎 <span>@comment.Comment.Dislikes</span></button></div> }@if (User.Identity?.IsAuthenticated == true) { <form action="/comment/createComment/@card.Review.Id" method="post" class="flex gap-2"><input type="hidden" name="pageName" value="@Model.Attraction.Id" /><input name="commentDesc" maxlength="200" required class="input input-bordered flex-1" placeholder="Write a comment" /><button class="btn btn-sm">Submit</button></form> }</div></div></article> }</section>
</main>
@section Scripts { <script>async function toggleReviewLike(id,b){const r=await fetch('/review/likePost/'+id,{method:'POST'});if(r.ok){const d=await r.json();b.querySelector('span').textContent=d.likes}} async function toggleComment(id,likes,b){const r=await fetch(`/comment/${likes?'likeComment':'dislikeComment'}/${id}`,{method:'POST'});if(r.ok){const d=await r.json();b.querySelector('span').textContent=likes?d.likes:d.dislikes}}</script> }

@model DayPlanViewModel
@{ ViewData["Title"] = "Plan your park day"; }
<main class="day-plan" aria-live="polite">
  <div class="day-plan-shell">
    <aside class="sunny-side" aria-label="Sunny, your park-planning guide">
      <div class="sunny-mascot" aria-hidden="true"><span class="sunny-ray sunny-ray-a"></span><span class="sunny-ray sunny-ray-b"></span><span class="sunny-ray sunny-ray-c"></span><span class="sunny-ray sunny-ray-d"></span><div class="sunny-face"><i></i><i></i><b></b></div></div>
      <p class="sunny-label">MEET SUNNY</p><h1>Let&apos;s make today magical.</h1><p>I&apos;ll build a simple ride plan around the things you actually want to experience.</p><div class="sunny-note"><span>✦</span><div><strong>No account needed</strong><small>Your plan stays on this device.</small></div></div>
    </aside>

    <section class="day-plan-card">
      <div class="day-plan-progress" aria-label="Planning progress"><span class="is-current" data-progress="1">1</span><i></i><span data-progress="2">2</span><i></i><span data-progress="3">3</span></div>
      <section class="plan-step is-active" data-step="1"><p class="plan-eyebrow">STEP 1 OF 3</p><h2>What park are you visiting today?</h2><p class="plan-lede">Choose one park and Sunny will pull together the right ride options.</p><div id="park-options" class="plan-park-options"></div></section>
      <section class="plan-step" data-step="2" hidden><button type="button" class="plan-back" data-back="1">&larr; Change park</button><p class="plan-eyebrow">STEP 2 OF 3</p><h2>Which rides are you interested in?</h2><p id="ride-count" class="plan-lede">Pick at least one. You can choose as many as you like.</p><div id="ride-options" class="plan-ride-options"></div><div class="plan-actions"><button type="button" id="optimize-plan" class="plan-primary" disabled>Optimize my day <span>&rarr;</span></button></div></section>
      <section class="plan-step plan-loading" data-step="3" hidden><div class="plan-orbit" aria-hidden="true"><span></span><span></span><span></span></div><p class="plan-eyebrow">SUNNY IS WORKING</p><h2>Optimizing your park day...</h2><p id="optimizing-copy" class="plan-lede">Looking at your favorites.</p><div class="plan-loading-lines"><span></span><span></span><span></span></div></section>
    </section>
  </div>
</main>

<style>
  .day-plan{min-height:calc(100vh - 76px);padding:clamp(1rem,4vw,3rem);background:radial-gradient(circle at 84% 9%,#ffe7aa 0,transparent 28%),#fffaf3;color:#172033}.day-plan-shell{display:grid;grid-template-columns:minmax(260px,.7fr) minmax(0,1.3fr);max-width:1110px;min-height:610px;margin:0 auto;border-radius:1.4rem;overflow:hidden;background:#fff;box-shadow:0 22px 60px rgba(22,47,77,.15)}.sunny-side{position:relative;overflow:hidden;padding:clamp(2rem,5vw,4.2rem);background:linear-gradient(154deg,#143a61,#28659a);color:#fff}.sunny-side::after{position:absolute;right:-5rem;bottom:-5rem;content:"";width:18rem;height:18rem;border:2.5rem solid rgba(255,255,255,.08);border-radius:50%}.sunny-mascot{position:relative;width:9.4rem;height:9.4rem;margin-bottom:2.2rem;border-radius:50%;background:#f9c763;box-shadow:0 12px 24px rgba(0,0,0,.18)}.sunny-ray{position:absolute;z-index:0;width:1.1rem;height:2.2rem;border-radius:99px;background:#f9c763}.sunny-ray-a{top:-1.7rem;left:4.1rem}.sunny-ray-b{top:3.6rem;right:-1.7rem;transform:rotate(90deg)}.sunny-ray-c{bottom:-1.7rem;left:4.1rem}.sunny-ray-d{top:3.6rem;left:-1.7rem;transform:rotate(90deg)}.sunny-face{position:absolute;inset:1.2rem;display:flex;align-items:center;justify-content:center;gap:1.2rem;border-radius:50%;background:#ffd980}.sunny-face i{width:.55rem;height:.75rem;border-radius:50%;background:#173b5f}.sunny-face b{position:absolute;bottom:1.15rem;width:1.5rem;height:.7rem;border-bottom:.26rem solid #173b5f;border-radius:50%}.sunny-label,.plan-eyebrow{margin:0;color:#f9ce79;font:800 .75rem/1 Karla,Arial,sans-serif;letter-spacing:.14em}.sunny-side h1{position:relative;z-index:1;margin:.8rem 0 1rem;font:800 clamp(2.3rem,4vw,3.6rem)/.98 Karla,Arial,sans-serif;letter-spacing:-.05em}.sunny-side>p{position:relative;z-index:1;max-width:20rem;margin:0;color:#e8f1f8;font:500 1rem/1.6 Karla,Arial,sans-serif}.sunny-note{position:relative;z-index:1;display:flex;align-items:center;gap:.7rem;margin-top:2.2rem;padding:1rem;border:1px solid rgba(255,255,255,.16);border-radius:.8rem;background:rgba(255,255,255,.09)}.sunny-note span{color:#f9ce79;font-size:1.2rem}.sunny-note strong,.sunny-note small{display:block;font-family:Karla,Arial,sans-serif}.sunny-note strong{font-size:.84rem}.sunny-note small{margin-top:.2rem;color:#e4edf6;font-size:.76rem}.day-plan-card{display:flex;flex-direction:column;padding:clamp(2rem,5vw,4.6rem);background:#fff}.day-plan-progress{display:flex;align-items:center;gap:.6rem;margin-bottom:3rem}.day-plan-progress span{display:grid;width:1.7rem;height:1.7rem;place-items:center;border-radius:50%;background:#edf1f5;color:#6c7a8c;font:800 .76rem Karla,Arial,sans-serif}.day-plan-progress span.is-current,.day-plan-progress span.is-complete{background:#1c5689;color:#fff}.day-plan-progress i{width:3.3rem;height:2px;background:#e2e7ed}.day-plan-progress i.is-complete{background:#1c5689}.plan-step{max-width:650px}.plan-step h2{margin:.75rem 0;font:800 clamp(2rem,4vw,3.15rem)/1 Karla,Arial,sans-serif;letter-spacing:-.055em}.plan-lede{margin:0;color:#5c6a7d;font:500 1rem/1.6 Karla,Arial,sans-serif}.plan-park-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem;margin-top:2rem}.plan-park{position:relative;min-height:138px;padding:1.15rem;border:1px solid #dce4ed;border-radius:.9rem;background:#fff;color:#172033;text-align:left;cursor:pointer;transition:.16s}.plan-park:hover,.plan-park[aria-pressed=true]{border-color:#1c5689;box-shadow:0 8px 19px rgba(27,86,137,.14);transform:translateY(-2px)}.plan-park[aria-pressed=true]::after{position:absolute;right:.7rem;top:.7rem;content:"✓";display:grid;place-items:center;width:1.45rem;height:1.45rem;border-radius:50%;background:#1c5689;color:#fff;font-weight:800}.plan-park small{display:block;color:#1c5689;font:800 .68rem Karla,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase}.plan-park strong{display:block;margin-top:.65rem;font:800 1.25rem Karla,Arial,sans-serif}.plan-park span{display:block;margin-top:.4rem;color:#627084;font:500 .8rem/1.35 Karla,Arial,sans-serif}.plan-back{margin:-.4rem 0 1.4rem;padding:0;border:0;background:transparent;color:#1c5689;font:800 .82rem Karla,Arial,sans-serif;cursor:pointer}.plan-ride-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin-top:1.55rem;max-height:380px;overflow:auto;padding:.1rem}.plan-ride{display:flex;align-items:flex-start;gap:.7rem;padding:.8rem;border:1px solid #dce4ed;border-radius:.7rem;background:#fff;cursor:pointer}.plan-ride:has(input:checked){border-color:#1c5689;background:#f0f7fc}.plan-ride input{margin:.15rem 0 0;accent-color:#1c5689}.plan-ride strong{display:block;font:800 .9rem/1.25 Karla,Arial,sans-serif}.plan-ride span{display:block;margin-top:.25rem;color:#667589;font:600 .71rem Karla,Arial,sans-serif}.plan-actions{display:flex;justify-content:flex-end;margin-top:1.8rem}.plan-primary{border:0;border-radius:.7rem;padding:.9rem 1.15rem;background:#f6bd60;color:#172033;font:800 .92rem Karla,Arial,sans-serif;cursor:pointer;box-shadow:0 5px 12px rgba(246,189,96,.26)}.plan-primary:disabled{opacity:.45;cursor:not-allowed;box-shadow:none}.plan-primary span{margin-left:.45rem}.plan-loading{text-align:center;margin:auto}.plan-orbit{position:relative;width:7.5rem;height:7.5rem;margin:0 auto 2rem;border:2px solid #dce7f0;border-radius:50%;animation:spin 3s linear infinite}.plan-orbit span{position:absolute;width:.78rem;height:.78rem;border-radius:50%;background:#f6bd60}.plan-orbit span:nth-child(1){top:-.42rem;left:3rem}.plan-orbit span:nth-child(2){bottom:1rem;right:-.4rem;background:#1c5689}.plan-orbit span:nth-child(3){bottom:.5rem;left:.45rem;background:#71bdd1}.plan-loading-lines{display:grid;gap:.5rem;margin:2rem auto 0;max-width:16rem}.plan-loading-lines span{height:.6rem;border-radius:99px;background:linear-gradient(90deg,#edf2f6,#d9e3ed,#edf2f6);background-size:200% 100%;animation:shimmer 1.4s infinite}.plan-loading-lines span:nth-child(2){width:78%;justify-self:center}.plan-loading-lines span:nth-child(3){width:58%;justify-self:center}@@keyframes spin{to{transform:rotate(360deg)}}@@keyframes shimmer{to{background-position:-200% 0}}@@media(max-width:780px){.day-plan{padding:0}.day-plan-shell{grid-template-columns:1fr;min-height:100vh;border-radius:0}.sunny-side{padding:2rem 1.5rem}.sunny-mascot{width:5rem;height:5rem;margin-bottom:1.3rem}.sunny-face{inset:.7rem;gap:.6rem}.sunny-face i{width:.36rem;height:.5rem}.sunny-face b{bottom:.6rem;width:.9rem;height:.4rem;border-width:.16rem}.sunny-ray-a{top:-1.4rem;left:2rem}.sunny-ray-b{top:1.8rem;right:-1.4rem}.sunny-ray-c{bottom:-1.4rem;left:2rem}.sunny-ray-d{top:1.8rem;left:-1.4rem}.sunny-side h1{font-size:2.2rem}.sunny-note{display:none}.day-plan-card{padding:2rem 1.5rem}.plan-park-options,.plan-ride-options{grid-template-columns:1fr}.plan-ride-options{max-height:none}}
</style>

@section Scripts {
<script>
  const dayPlanData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
    parks = Model.Parks.Select(park => new { id = park.Id, name = park.Name, tagline = park.Tagline, mapRoute = park.MapRoute }),
    rides = Model.Rides.Select(ride => new { id = ride.Id, name = ride.Name, description = ride.Description, tags = ride.Tags, parkId = ride.ParkId })
  }));
  const queryPark = new URLSearchParams(location.search).get("park");
  let selectedPark = dayPlanData.parks.find(park => park.id === queryPark) || null;
  const selectedRides = new Set();
  const step = value => {
    document.querySelectorAll(".plan-step").forEach(item => { item.hidden = item.dataset.step !== String(value); item.classList.toggle("is-active", item.dataset.step === String(value)); });
    document.querySelectorAll("[data-progress]").forEach(item => { const current = Number(item.dataset.progress); item.classList.toggle("is-current", current === value); item.classList.toggle("is-complete", current < value); });
    document.querySelectorAll(".day-plan-progress i").forEach((item, index) => item.classList.toggle("is-complete", index < value - 1));
  };
  const renderParks = () => {
    const root = document.getElementById("park-options"); root.replaceChildren(...dayPlanData.parks.map(park => { const button = document.createElement("button"); button.type = "button"; button.className = "plan-park"; button.setAttribute("aria-pressed", String(selectedPark?.id === park.id)); button.innerHTML = `<small>${park.tagline}</small><strong>${park.name}</strong><span>Choose this park</span>`; button.addEventListener("click", () => { selectedPark = park; selectedRides.clear(); renderParks(); renderRides(); setTimeout(() => step(2), 180); }); return button; }));
  };
  const renderRides = () => {
    const choices = dayPlanData.rides.filter(ride => ride.parkId === selectedPark?.id); const root = document.getElementById("ride-options"); root.replaceChildren(...choices.map(ride => { const label = document.createElement("label"); label.className = "plan-ride"; label.innerHTML = `<input type="checkbox" value="${ride.id}"><span><strong></strong><span></span></span>`; const input = label.querySelector("input"); input.checked = selectedRides.has(ride.id); label.querySelector("strong").textContent = ride.name; label.querySelector("span span").textContent = (ride.tags || []).slice(0, 2).join(" · ") || "Ride"; input.addEventListener("change", () => { input.checked ? selectedRides.add(ride.id) : selectedRides.delete(ride.id); updateRideCount(); }); return label; })); updateRideCount();
  };
  const updateRideCount = () => { const count = selectedRides.size; document.getElementById("ride-count").textContent = count ? `${count} ride${count === 1 ? "" : "s"} selected. Sunny will prioritize these in your planner.` : "Pick at least one. You can choose as many as you like."; document.getElementById("optimize-plan").disabled = count === 0; };
  document.querySelectorAll("[data-back]").forEach(button => button.addEventListener("click", () => step(Number(button.dataset.back))));
  document.getElementById("optimize-plan").addEventListener("click", () => {
    const parkRides = dayPlanData.rides.filter(ride => selectedRides.has(ride.id));
    localStorage.setItem(`sunshine-my-day:${selectedPark.id}`, JSON.stringify({ parkId: selectedPark.id, createdAt: new Date().toISOString(), rides: parkRides.map(ride => ({ id: ride.id, name: ride.name, done: false })) }));
    step(3); const copy = document.getElementById("optimizing-copy"); const messages = ["Looking at your favorites.", "Balancing live waits and walking distance.", "Your plan is ready!"]; messages.forEach((message, index) => setTimeout(() => copy.textContent = message, index * 650)); setTimeout(() => location.assign(`${selectedPark.mapRoute}?plan=ready`), 2050);
  });
  renderParks(); if (selectedPark) { renderRides(); step(2); }
</script>
}

@model SunshineAttractions.Controllers.SignupInput
@{ ViewData["Title"] = "Create your account"; }
<main class="auth-page">
  <section class="auth-visual"><div class="auth-visual-copy"><p class="eyebrow">JOIN THE COMMUNITY</p><h2>Share the rides worth the wait.</h2><p>Create an account to add your perspective, rate attractions, and help fellow park visitors plan a memorable day.</p></div></section>
  <section class="auth-panel"><div class="auth-card"><img class="auth-logo" src="/assets/image/Sunshine%20Attractions-logo/sunshine-logo-transparent%20(2).png" alt="Sunshine Attractions" /><p class="eyebrow" style="color:#235b91">GET STARTED</p><h1>Create account</h1><p class="auth-lede">It takes less than a minute to join the Sunshine Attractions community.</p><form class="auth-form" method="post" action="/signup"><div asp-validation-summary="ModelOnly" class="auth-errors"></div><div><label asp-for="UserName">Display name</label><input asp-for="UserName" maxlength="7" autocomplete="username" placeholder="Up to 7 characters" /><span asp-validation-for="UserName" class="field-error"></span></div><div><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="field-error"></span></div><div><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="new-password" placeholder="At least 8 characters" /><span asp-validation-for="Password" class="field-error"></span></div><div><label asp-for="ConfirmPassword">Confirm password</label><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Repeat your password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div><button class="auth-submit" type="submit">Create my account</button></form><p class="auth-switch">Already have an account? <a href="/login">Log in</a></p></div></section>
</main>

@model User
@{ ViewData["Title"] = "Profile"; }
<main class="flex flex-col md:flex-row min-h-[70vh]"><aside class="md:w-1/4 bg-gray-50 p-5"><ul class="menu"><li><a class="active">Settings</a></li><li><a href="/your-reviews">Your reviews</a></li><li><a href="/your-comments">Your comments</a></li></ul></aside><section class="flex-1 flex flex-col justify-center items-center p-10"><h1 class="text-5xl font-bold">Welcome, @Model.UserName!</h1><div class="avatar m-8"><div class="w-32 rounded-full"><img src="@Model.ProfilePic" alt="Your profile picture" /></div></div><p class="alert max-w-md">Image uploads are not currently supported.</p></section></main>

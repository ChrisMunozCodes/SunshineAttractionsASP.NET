@model User
@{ ViewData["Title"] = "Your profile"; }
<main class="profile-page">
  <section class="profile-hero"><div><p class="profile-kicker">YOUR SUNSHINE ACCOUNT</p><h1>Hi, @Model.UserName.</h1><p>Keep your reviews, comments, plans, and Park Circles in one easy place.</p></div><img src="@Model.ProfilePic" alt="@Model.UserName's profile picture" /></section>
  <section class="profile-grid">
    <nav class="profile-nav" aria-label="Profile navigation"><p>ACCOUNT</p><a class="is-current" href="/profile">Profile overview</a><a href="/your-reviews">Your reviews</a><a href="/your-comments">Your comments</a><a href="/circle">Your Park Circles</a></nav>
    <section class="profile-content"><p class="profile-kicker">PROFILE</p><h2>Your park-day home base</h2><p class="profile-lede">Your display name appears with reviews and comments you share with other visitors.</p><dl class="profile-details"><div><dt>Display name</dt><dd>@Model.UserName</dd></div><div><dt>Email</dt><dd>@Model.Email</dd></div></dl><div class="profile-callout"><strong>Profile photos are not available yet.</strong><span>Your current profile image is the Sunshine default while uploads are paused.</span></div><div class="profile-actions"><a href="/plan">Plan a park day</a><a href="/map/maps">Open live maps</a></div></section>
  </section>
</main>

<style>
  .profile-page{max-width:1120px;margin:0 auto;padding:clamp(1.25rem,4vw,3.5rem);font-family:Karla,Arial,sans-serif;color:#172033}.profile-hero{display:flex;align-items:center;justify-content:space-between;gap:1.5rem;overflow:hidden;border-radius:1.2rem;padding:clamp(1.6rem,4vw,3rem);background:linear-gradient(120deg,#102d4b,#215d90 68%,#f6bd60);color:#fff;box-shadow:0 15px 35px rgba(18,47,77,.16)}.profile-kicker{margin:0;color:#f6bd60;font:800 .72rem/1 Karla,sans-serif;letter-spacing:.14em}.profile-hero h1{margin:.55rem 0;font:800 clamp(2.3rem,5vw,4rem)/.95 Karla,sans-serif;letter-spacing:-.055em}.profile-hero p:last-child{max-width:35rem;margin:0;color:#e8f2f9;line-height:1.55}.profile-hero img{width:6.5rem;height:6.5rem;flex:none;border:4px solid rgba(255,255,255,.38);border-radius:50%;object-fit:cover;background:#dceaf4}.profile-grid{display:grid;grid-template-columns:14rem minmax(0,1fr);gap:1.25rem;margin-top:1.25rem}.profile-nav,.profile-content{border:1px solid #e0e8ef;border-radius:1rem;background:#fff;box-shadow:0 8px 20px rgba(18,34,56,.06)}.profile-nav{align-self:start;padding:.8rem}.profile-nav p{margin:.5rem .65rem;color:#6c7b8b;font:800 .68rem Karla,sans-serif;letter-spacing:.12em}.profile-nav a{display:block;margin:.2rem 0;border-radius:.55rem;padding:.7rem .65rem;color:#42566a;font:800 .82rem Karla,sans-serif;text-decoration:none}.profile-nav a:hover,.profile-nav a.is-current{background:#eaf3f9;color:#174577}.profile-content{padding:clamp(1.4rem,4vw,2.4rem)}.profile-content .profile-kicker{color:#1d5b90}.profile-content h2{margin:.45rem 0 .65rem;font:800 clamp(1.8rem,4vw,2.65rem)/1 Karla,sans-serif;letter-spacing:-.05em}.profile-lede{max-width:42rem;margin:0;color:#5d7082;line-height:1.55}.profile-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin:1.5rem 0}.profile-details div{border:1px solid #e1e8ef;border-radius:.7rem;padding:.85rem;background:#fbfdff}.profile-details dt{color:#68798b;font:800 .67rem Karla,sans-serif;letter-spacing:.1em;text-transform:uppercase}.profile-details dd{margin:.35rem 0 0;overflow-wrap:anywhere;color:#1c3148;font:800 .95rem Karla,sans-serif}.profile-callout{display:grid;gap:.3rem;border-radius:.7rem;background:#fff4dc;padding:1rem;color:#6e5018;font:.8rem/1.45 Karla,sans-serif}.profile-callout strong{font-size:.84rem}.profile-actions{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.4rem}.profile-actions a{border-radius:.55rem;background:#174577;padding:.7rem .85rem;color:#fff;font:800 .78rem Karla,sans-serif;text-decoration:none}.profile-actions a+a{background:#eaf2f7;color:#174577}@@media(max-width:700px){.profile-page{padding:1rem}.profile-hero{align-items:start;flex-direction:column}.profile-grid{grid-template-columns:1fr}.profile-nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.profile-nav p{grid-column:1/-1}.profile-details{grid-template-columns:1fr}}@@media(max-width:420px){.profile-nav{grid-template-columns:1fr}.profile-hero img{width:5rem;height:5rem}}
</style>

<style>
  html:has(.auth-page),body:has(.auth-page){margin:0;min-height:100%;background:#fffaf3}
  .auth-page{box-sizing:border-box;min-height:100vh;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(420px,.95fr);font-family:Karla,Arial,sans-serif;color:#132238;background:#fff}
  .auth-visual{position:relative;isolation:isolate;display:flex;min-height:38rem;align-items:flex-end;overflow:hidden;padding:clamp(2rem,6vw,5rem);background:#173f67;color:#fff}
  .auth-visual::before{position:absolute;z-index:-2;inset:0;content:"";background:url('/assets/image/Sunshine%20Attractions-logo/Cinderella%27s_Golden_Carrousel_TDL.jpeg') center/cover no-repeat}
  .auth-visual::after{position:absolute;z-index:-1;inset:0;content:"";background:linear-gradient(0deg,rgba(7,23,42,.88),rgba(7,23,42,.27) 62%,rgba(7,23,42,.1))}
  .auth-visual-copy{max-width:33rem}.auth-visual-copy h2{margin:.65rem 0 0;font-size:clamp(2.5rem,4.5vw,4.6rem);font-weight:800;line-height:.96;letter-spacing:-.06em}.auth-visual-copy>p:last-child{margin:1.15rem 0 0;color:#edf4fa;font-size:1.02rem;line-height:1.65}
  .auth-panel{display:flex;align-items:center;justify-content:center;padding:clamp(2rem,6vw,5rem);background:radial-gradient(circle at 92% 8%,#ffe8b0,transparent 22rem),#fffaf3}.auth-card{width:min(100%,29rem)}
  .auth-logo{display:block;width:min(100%,23rem);height:auto;margin:0 0 clamp(1.5rem,4vh,2.8rem)}.auth-panel h1{margin:.35rem 0 0;color:#132238;font-size:clamp(2.8rem,5vw,4.5rem);font-weight:800;line-height:.94;letter-spacing:-.065em}.auth-lede{margin:.85rem 0 2rem;color:#526277;font-size:1rem;line-height:1.55}.eyebrow{margin:0;color:#f6bd60;font-size:.76rem;font-weight:800;letter-spacing:.15em}
  .auth-form{display:grid;gap:1.1rem}.auth-form>div:not(.auth-errors){display:grid;gap:.42rem}.auth-form label{color:#334155;font-size:.88rem;font-weight:800}.auth-form input:not([type=hidden]){box-sizing:border-box;width:100%;border:1px solid #cfd8e3;border-radius:.65rem;background:#fff;padding:.9rem .95rem;color:#132238;font:1rem Karla,Arial,sans-serif;outline:none;transition:border-color .16s,box-shadow .16s}.auth-form input:not([type=hidden]):focus{border-color:#235b91;box-shadow:0 0 0 3px rgba(35,91,145,.14)}.auth-form input::placeholder{color:#8b9aaf}.auth-submit{margin-top:.35rem;border:0;border-radius:.65rem;background:#173f67;padding:1rem;color:#fff;font:800 .95rem Karla,Arial,sans-serif;cursor:pointer;transition:transform .16s,background .16s;box-shadow:0 8px 18px rgba(23,63,103,.18)}.auth-submit:hover{background:#235b91;transform:translateY(-1px)}
  .auth-switch{margin:1.35rem 0 0;color:#526277;font-size:.94rem}.auth-switch a{color:#1d5a91;font-weight:800;text-decoration:none}.auth-switch a:hover{text-decoration:underline}.auth-note{margin:1.5rem 0 0;border-top:1px solid #e4e9ef;padding-top:1.05rem;color:#718096;font-size:.8rem;line-height:1.55}.auth-errors:not(:has(ul)):empty{display:none}.auth-errors{border-radius:.65rem;background:#fee2e2;padding:.8rem .9rem;color:#991b1b;font-size:.88rem;line-height:1.45}.auth-errors ul{margin:0;padding-left:1rem}.field-error{min-height:1em;color:#b42318;font-size:.8rem}
  @@media(max-width:820px){.auth-page{grid-template-columns:1fr}.auth-visual{min-height:17rem;padding:2rem 1.5rem}.auth-visual-copy h2{font-size:2.35rem}.auth-visual-copy>p:last-child{display:none}.auth-panel{min-height:auto;padding:2.5rem 1.5rem 3.5rem}.auth-logo{width:min(100%,18rem);margin-bottom:1.65rem}}
  @@media(max-width:420px){.auth-panel{padding:2rem 1.1rem 3rem}.auth-visual{padding:1.75rem 1.1rem}.auth-panel h1{font-size:3.1rem}}
</style>

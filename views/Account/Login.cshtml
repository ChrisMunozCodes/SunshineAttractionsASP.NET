@model SunshineAttractions.Controllers.LoginInput
@{ ViewData["Title"] = "Welcome back"; }
<partial name="_AuthStyles" />
<main class="auth-page">
  <section class="auth-visual"><div class="auth-visual-copy"><p class="eyebrow">SUNSHINE ATTRACTIONS</p><h2>Every great park day starts with a plan.</h2><p>Sign in to share reviews, save your voice in the community, and make better choices in the park.</p></div></section>
  <section class="auth-panel"><div class="auth-card"><img class="auth-logo" src="/assets/image/Sunshine%20Attractions-logo/sunshine-logo-transparent%20(2).png" alt="Sunshine Attractions" /><p class="eyebrow" style="color:#235b91">WELCOME BACK</p><h1>Log in</h1><p class="auth-lede">Pick up where your next adventure left off.</p><form class="auth-form" method="post" action="/login"><div asp-validation-summary="ModelOnly" class="auth-errors"></div><input asp-for="ReturnUrl" type="hidden" /><div><label asp-for="Email">Email address</label><input asp-for="Email" autocomplete="email" placeholder="you@example.com" /><span asp-validation-for="Email" class="field-error"></span></div><div><label asp-for="Password">Password</label><input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" /><span asp-validation-for="Password" class="field-error"></span></div><button class="auth-submit" type="submit">Log in to Sunshine Attractions</button></form><p class="auth-switch">New here? <a href="/signup">Create an account</a></p><p class="auth-note">Your account lets you write reviews, join the conversation, and build a better park guide with other visitors.</p></div></section>
</main>

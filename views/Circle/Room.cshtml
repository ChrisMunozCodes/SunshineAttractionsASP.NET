@model ParkCircle
@using SunshineAttractions.Services
@{ ViewData["Title"] = $"{Model.Name} Park Circle"; var park = ViewData["Park"] as ParkGuide; var apiUrl = ViewData["MapApiUrl"] as string; }

<main class="circle-room">
  <section class="circle-room-hero"><div><p class="circle-kicker">PARK CIRCLE · ACTIVE TODAY</p><h1>@Model.Name</h1><p>@park?.Name · This Circle automatically closes at @Model.ExpiresAt.ToLocalTime().ToString("h:mm tt").</p></div><div class="circle-room-actions"><button id="circle-share-location" type="button">Share my location</button><button id="circle-stop-location" type="button" hidden>Stop sharing</button><button id="circle-copy-invite" type="button">Copy invite</button><button id="circle-leave" type="button">Leave Circle</button></div></section>
  <div id="circle-status" class="circle-status" role="status">Loading your Circle…</div>
  <section class="circle-room-layout"><div class="circle-map-card"><div id="circle-map" aria-label="Park Circle member locations"></div><p>Locations only appear when a member chooses to share while this page is open. Pins disappear when their update becomes stale.</p></div><aside class="circle-members"><p class="circle-kicker">YOUR PEOPLE</p><h2>Who's here</h2><ol id="circle-member-list"></ol><div class="circle-room-note"><strong>Plan together too</strong><span>Use Share plan from a park timeline to send rides and food stops. A Circle never adds anyone’s location to that link.</span></div></aside></section>
  <section class="circle-privacy-bar"><strong>Location sharing is optional.</strong><span>Sunshine stores only the latest shared point for this active Circle—never a location history. This is not a background-tracking or emergency service.</span></section>
</main>

<script>
  window.parkCircleConfig = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { id = Model.Id.ToString(), inviteUrl = Url.Action("Join", "Circle", new { inviteCode = Model.InviteCode }, Context.Request.Scheme), park = new { name = park?.Name, latitude = park?.Latitude, longitude = park?.Longitude } }));
</script>
<script src="/assets/js/circle-room.js?v=park-circle-v1"></script>
@if (!string.IsNullOrWhiteSpace(apiUrl)) { <script async src="@apiUrl"></script> }

<style>
  .circle-room{max-width:1440px;margin:0 auto;padding:2rem 1.25rem 3rem;background:#fffaf3;color:#172033;font-family:Karla,Arial,sans-serif}.circle-room-hero{display:flex;align-items:end;justify-content:space-between;gap:1.5rem;padding:1.5rem 1.75rem;border-radius:1.25rem;background:linear-gradient(118deg,#102a43,#1d4e89 62%,#f6bd60);color:#fff;box-shadow:0 12px 28px rgba(16,42,67,.18)}.circle-kicker{margin:0;color:#f6c869;font:800 .72rem/1 Karla,sans-serif;letter-spacing:.14em}.circle-room-hero h1{margin:.45rem 0;font:800 clamp(2rem,5vw,3.4rem)/1 Karla,sans-serif;letter-spacing:-.05em}.circle-room-hero p:last-child{margin:0;color:#eef6fc;font:.92rem/1.45 Karla,sans-serif}.circle-room-actions{display:flex;flex-wrap:wrap;gap:.55rem}.circle-room-actions button{border:0;border-radius:.55rem;background:#fff;padding:.7rem .8rem;color:#174577;font:800 .78rem Karla,sans-serif;cursor:pointer}.circle-room-actions button:first-child{background:#f6bd60;color:#182c40}.circle-room-actions button:last-child{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.28)}.circle-status{margin:1rem 0;color:#38536d;font:700 .84rem Karla,sans-serif}.circle-status[data-state=error]{color:#a22}.circle-status[data-state=success]{color:#166534}.circle-room-layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(18rem,.75fr);gap:1.25rem}.circle-map-card,.circle-members{overflow:hidden;border:1px solid #e1e8ef;border-radius:1rem;background:#fff;box-shadow:0 8px 20px rgba(36,59,81,.08)}#circle-map{height:min(65vh,650px);min-height:420px}.circle-map-card p{margin:0;padding:.75rem 1rem;background:#f8fafc;color:#617286;font:.76rem/1.4 Karla,sans-serif}.circle-members{padding:1.2rem}.circle-members .circle-kicker{color:#1d5b90}.circle-members h2{margin:.4rem 0 1rem;font:800 1.4rem Karla,sans-serif}.circle-members ol{display:grid;gap:.65rem;margin:0;padding:0;list-style:none}.circle-member{display:flex;align-items:center;gap:.7rem;border:1px solid #e4ebf0;border-radius:.7rem;padding:.7rem}.circle-member-avatar{display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:#dcecf6;color:#174577;font:800 .82rem Karla,sans-serif}.circle-member strong{display:block;font:800 .88rem Karla,sans-serif}.circle-member span{display:block;margin-top:.12rem;color:#66778a;font:.7rem Karla,sans-serif}.circle-member i{margin-left:auto;width:.55rem;height:.55rem;border-radius:50%;background:#b9c4ce}.circle-member i[data-sharing=true]{background:#22a06b;box-shadow:0 0 0 .22rem #e4f7ec}.circle-room-note{display:grid;gap:.3rem;margin-top:1rem;padding:1rem;border-radius:.7rem;background:#fff4d9;color:#654812;font:.78rem/1.45 Karla,sans-serif}.circle-room-note strong{font:800 .82rem Karla,sans-serif}.circle-privacy-bar{display:flex;gap:.8rem;align-items:start;margin-top:1.25rem;padding:1rem;border:1px solid #dbe6ee;border-radius:.8rem;background:#eff7fb;color:#40596e;font:.78rem/1.45 Karla,sans-serif}.circle-privacy-bar strong{flex:none;color:#174577}@@media(max-width:900px){.circle-room-hero{align-items:start;flex-direction:column}.circle-room-layout{grid-template-columns:1fr}.circle-members{order:-1}}@@media(max-width:520px){.circle-room{padding:1rem}.circle-room-hero{padding:1.25rem}.circle-room-actions{display:grid;width:100%}.circle-room-actions button{width:100%}#circle-map{height:52vh;min-height:350px}.circle-privacy-bar{flex-direction:column}}
</style>

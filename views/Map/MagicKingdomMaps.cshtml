</style>

@section Scripts {
  <script>
    window.magicKingdomMapConfig = {
      markers: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => new { name = m.Name, lat = m.Latitude, lng = m.Longitude.FirstOrDefault(), wait = m.Wait }))),
      places: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(parkPlaces))
    };
  </script>
  <script src="/assets/js/map-scripts/magic-kingdom-recommendations.js?v=shared-plan-v1"></script>
  @if (!string.IsNullOrWhiteSpace(apiUrl)) { <script async src="@apiUrl"></script> }
}

@model IReadOnlyList<Marker>
@{ ViewData["Title"] = "Magic Kingdom map"; var apiUrl = ViewData["MapApiUrl"] as string; var parkPlaces = ViewData["ParkPlaces"] as IReadOnlyList<ParkPlace> ?? []; }

<main class="mk-page">
  <section class="mk-hero">
    <div>
      <p class="mk-eyebrow">MAGIC KINGDOM · LIVE PLANNER</p>
      <h1>Find your next great ride</h1>
      <p class="mk-subtitle">Share your location to balance walking distance with current standby waits. Your location stays in this browser.</p>
    </div>
    <div class="mk-actions">
      <button id="open-mk-finder" class="mk-secondary" type="button">Food + essentials</button>
      <button id="share-location" class="mk-primary" type="button">Use my location</button>
      <button id="refresh-waits" class="mk-secondary" type="button">Refresh waits</button>
    </div>
  </section>

  <p id="planner-status" class="mk-status" role="status">Loading live wait times…</p>
  @if (ViewData["MarkerDataUnavailable"] is true) { <p class="mk-status">Using built-in attraction locations while saved marker data reconnects.</p> }

  <section class="mk-layout">
    <div class="mk-map-card">
      <div id="map" class="mk-map" aria-label="Magic Kingdom attraction map"></div>
      <p class="mk-map-note">Live wait times are powered by <a href="https://queue-times.com/" target="_blank" rel="noopener">Queue-Times.com</a> and can change at any time.</p>
    </div>

    <aside class="mk-recommendations" aria-live="polite">
      <section class="mk-filters" aria-labelledby="filter-heading">
        <div class="mk-filter-heading"><div><p class="mk-eyebrow">RIDE FILTERS</p><h2 id="filter-heading">What sounds good?</h2></div><button id="clear-filters" class="mk-clear" type="button" hidden>Clear</button></div>
        <div class="mk-filter-options">
          <label class="mk-filter"><input type="checkbox" value="coaster" /><span>Roller coasters</span></label>
          <label class="mk-filter"><input type="checkbox" value="dark" /><span>Dark rides</span></label>
          <label class="mk-filter"><input type="checkbox" value="family" /><span>Family-friendly</span></label>
          <label class="mk-filter"><input type="checkbox" value="adventure" /><span>Adventure</span></label>
          <label class="mk-filter"><input type="checkbox" value="gentle" /><span>Gentle rides</span></label>
        </div>
      </section>
      <section id="my-day-summary" class="mk-day-summary" hidden><div><p class="mk-eyebrow">YOUR DAY PLAN</p><strong id="my-day-count"></strong></div><a id="edit-my-day" href="/plan?park=magic-kingdom">Edit plan</a></section>
      <section class="mk-timeline" aria-live="polite"><div class="mk-timeline-heading"><div><p class="mk-eyebrow">SMART DAY TIMELINE</p><h2>Your route, right now</h2></div><span id="mk-timeline-state">Ready</span></div><p id="mk-timeline-copy">Choose your must-do rides and Sunny will turn them into a live, walk-aware route.</p><ol id="mk-timeline-list" hidden></ol><ol id="mk-timeline-stops" hidden></ol><div class="mk-timeline-actions"><button id="mk-timeline-optimize" type="button">Use my location</button><a href="/plan?park=magic-kingdom">Choose rides</a><button id="mk-timeline-food" type="button">Plan a food stop</button><button id="mk-timeline-share" type="button">Share plan</button></div><p id="mk-timeline-note">Your plan stays on this device. Waits are refreshed from the live board.</p></section>
      <div class="mk-panel-heading">
        <div><p class="mk-eyebrow">PERSONAL PICKS</p><h2>Best choices nearby</h2></div>
        <span id="location-state" class="mk-pill">Location off</span>
      </div>
      <p id="recommendation-empty" class="mk-empty">Share your location to see the three best ride choices for where you are right now.</p>
      <ol id="recommendation-list" class="mk-list" hidden></ol>
      <div class="mk-how-it-works"><strong>How it works</strong><span>We prioritize lower waits, then shorter walks. Your location is not saved or sent to our server.</span></div>
    </aside>
  </section>
</main>

<section id="mk-finder" class="mk-finder" hidden role="dialog" aria-modal="true" aria-labelledby="mk-finder-title">
  <div class="mk-finder-sheet"><header><div><p>NEARBY WITH SUNNY</p><h2 id="mk-finder-title">Food + essentials</h2></div><button id="close-mk-finder" type="button" aria-label="Close finder">&times;</button></header><div class="mk-finder-intro"><p id="mk-finder-location">Use your location to put the closest spots first.</p><button id="mk-finder-location-button" type="button">Use my location</button></div><div class="mk-finder-filters"><button data-mk-finder-filter="all" aria-pressed="true">All</button><button data-mk-finder-filter="food" aria-pressed="false">Food</button><button data-mk-finder-filter="restroom" aria-pressed="false">Restrooms</button><button data-mk-finder-filter="first-aid" aria-pressed="false">First aid</button><button data-mk-finder-filter="locker" aria-pressed="false">Lockers</button></div><div class="mk-finder-diets" aria-label="Dietary preferences"><span>Dietary preferences</span><button data-mk-diet-filter="all" aria-pressed="true">No preference</button><button data-mk-diet-filter="Pescatarian-friendly" aria-pressed="false">Pescatarian</button><button data-mk-diet-filter="Vegetarian options" aria-pressed="false">Vegetarian</button></div><p id="mk-finder-empty" hidden></p><ol id="mk-finder-list"></ol><footer>Dietary filters are convenience guides—not allergy guarantees. Confirm ingredients and cross-contact needs with the restaurant.</footer></div>
</section>


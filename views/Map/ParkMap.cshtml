@model ParkGuide
@{ ViewData["Title"] = $"{Model.Name} planner"; var apiUrl = ViewData["MapApiUrl"] as string; var parkPlaces = ViewData["ParkPlaces"] as IReadOnlyList<ParkPlace> ?? []; }
<main class="planner-page">
  <section class="planner-hero">
    <div>
      <p class="planner-eyebrow">@Model.Name.ToUpperInvariant() &middot; LIVE PLANNER</p>
      <h1>Find your next great ride</h1>
      <p class="planner-subtitle">Share your location to balance walking distance with current standby waits. Your location stays in this browser.</p>
    </div>
    <div class="planner-actions"><button id="start-park-mode" class="planner-primary" type="button">Start Park Mode</button><button id="open-park-finder" class="planner-secondary" type="button">Food + essentials</button><button id="share-location" class="planner-secondary" type="button">Use my location</button><button id="refresh-waits" class="planner-secondary" type="button">Refresh waits</button></div>
  </section>

  <p id="planner-status" class="planner-status" role="status">Loading live wait times&hellip;</p>
  <section class="planner-layout">
    <div class="planner-map-card"><div id="map" class="planner-map" aria-label="@Model.Name attraction map"></div><p class="planner-map-note">Live wait times are powered by <a href="https://queue-times.com/" target="_blank" rel="noopener">Queue-Times.com</a> and can change at any time.</p></div>
    <aside class="planner-recommendations" aria-live="polite">
      <section class="planner-filters" aria-labelledby="filter-heading">
        <div class="planner-filter-heading"><div><p class="planner-eyebrow">RIDE FILTERS</p><h2 id="filter-heading">What sounds good?</h2></div><button id="clear-filters" class="planner-clear" type="button" hidden>Clear</button></div>
        <div class="planner-filter-options"><label class="planner-filter"><input type="checkbox" value="coaster" /><span>Roller coasters</span></label><label class="planner-filter"><input type="checkbox" value="dark" /><span>Dark rides</span></label><label class="planner-filter"><input type="checkbox" value="family" /><span>Family-friendly</span></label><label class="planner-filter"><input type="checkbox" value="adventure" /><span>Adventure</span></label><label class="planner-filter"><input type="checkbox" value="gentle" /><span>Gentle rides</span></label></div>
      </section>
      <section id="my-day-summary" class="planner-day-summary" hidden><div><p class="planner-eyebrow">YOUR DAY PLAN</p><strong id="my-day-count"></strong></div><a id="edit-my-day" href="/plan">Edit plan</a></section>
      <section id="plan-b" class="planner-plan-b" hidden><p class="planner-eyebrow">SUNNY'S PLAN B</p><h2 id="plan-b-heading">A ride in your plan is closed</h2><p id="plan-b-message"></p><ol id="plan-b-list" class="planner-plan-b-list"></ol></section>
      <section class="planner-watch" aria-labelledby="ride-watch-heading"><div><p class="planner-eyebrow">RIDE WATCH</p><h2 id="ride-watch-heading">Watch temporary closures</h2></div><p>Tap a closed ride on the map to watch it. Sunshine checks while this page stays open.</p><ol id="ride-watch-list" class="planner-watch-list"></ol></section>
      <div class="planner-panel-heading"><div><p class="planner-eyebrow">PERSONAL PICKS</p><h2>Best choices nearby</h2></div><span id="location-state" class="planner-pill">Location off</span></div>
      <p id="recommendation-empty" class="planner-empty">Share your location to see the three best ride choices for where you are right now.</p><ol id="recommendation-list" class="planner-list" hidden></ol>
      <div class="planner-how-it-works"><strong>How it works</strong><span>We prioritize lower waits, then shorter walks. Your location is not saved or sent to our server.</span></div>
    </aside>
  </section>
</main>

<section id="park-mode" class="park-mode" hidden role="dialog" aria-modal="true" aria-labelledby="park-mode-title">
  <div class="park-mode-shell">
    <header class="park-mode-header"><div><p class="park-mode-kicker">SUNNY'S PARK MODE</p><strong>@Model.Name</strong></div><button id="exit-park-mode" type="button" class="park-mode-exit">Exit</button></header>
    <main class="park-mode-main"><div class="park-mode-sun" aria-hidden="true">&#9788;</div><p id="park-mode-overline" class="park-mode-overline">YOUR NEXT MOVE</p><h2 id="park-mode-title">Finding your best next stop&hellip;</h2><p id="park-mode-reason" class="park-mode-reason">Use your location and Sunny will balance the walk with live wait times.</p><div id="park-mode-metrics" class="park-mode-metrics" hidden><span id="park-mode-wait"></span><span id="park-mode-distance"></span></div><div class="park-mode-actions"><button id="park-mode-location" type="button" class="park-mode-location">Use my location</button><a id="park-mode-navigate" href="#" class="park-mode-go" target="_blank" rel="noopener" hidden>Navigate there</a><button id="park-mode-done" type="button" class="park-mode-done" hidden>Mark done</button><button id="park-mode-skip" type="button" class="park-mode-skip" hidden>Skip for now</button></div><p id="park-mode-progress" class="park-mode-progress"></p></main>
  </div>
</section>

<section id="park-finder" class="park-finder" hidden role="dialog" aria-modal="true" aria-labelledby="park-finder-title">
  <div class="park-finder-sheet">
    <header class="park-finder-header"><div><p>NEARBY WITH SUNNY</p><h2 id="park-finder-title">Food + essentials</h2></div><button id="close-park-finder" type="button" aria-label="Close food and essentials finder">&times;</button></header>
    <div class="park-finder-intro"><p id="park-finder-location">Use your location to put the closest spots first.</p><button id="finder-use-location" type="button">Use my location</button></div>
    <div class="park-finder-filters" aria-label="Filter places"><button type="button" data-finder-filter="all" aria-pressed="true">All</button><button type="button" data-finder-filter="food" aria-pressed="false">Food</button><button type="button" data-finder-filter="restroom" aria-pressed="false">Restrooms</button><button type="button" data-finder-filter="first-aid" aria-pressed="false">First aid</button><button type="button" data-finder-filter="locker" aria-pressed="false">Lockers</button><button type="button" data-finder-filter="break" aria-pressed="false">Indoor break</button></div>
    <p id="park-finder-empty" class="park-finder-empty" hidden></p><ol id="park-finder-list" class="park-finder-list"></ol>
    <footer class="park-finder-footer">Locations are curated for planning support. Confirm hours and availability in the official park app.</footer>
  </div>
</section>

<style>
  .planner-day-summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:0 0 1.15rem;padding:.85rem 1rem;border-radius:.75rem;background:#eaf4fb;color:#174577}.planner-day-summary .planner-eyebrow{color:#1d4e89;opacity:1}.planner-day-summary strong{display:block;margin-top:.3rem;font:800 .9rem Karla,sans-serif}.planner-day-summary a{color:#174577;font:800 .78rem Karla,sans-serif}.planner-rec-actions{display:flex;gap:.5rem;margin-top:.8rem}.planner-navigate,.planner-done{border:0;border-radius:.42rem;padding:.38rem .55rem;background:#e9f2f8;color:#174577;font:800 .72rem Karla,sans-serif;text-decoration:none;cursor:pointer}.planner-done{background:#e5f4e8;color:#166534}.planner-plan-b{margin:0 0 1.15rem;padding:1rem;border:1px solid #f4cf83;border-radius:.8rem;background:#fff7e5;color:#5a431a}.planner-plan-b .planner-eyebrow{color:#aa6611}.planner-plan-b h2,.planner-watch h2{margin:.32rem 0 0;font:800 1.1rem Karla,sans-serif}.planner-plan-b>p:not(.planner-eyebrow),.planner-watch>p{margin:.65rem 0 0;font:.82rem/1.45 Karla,sans-serif}.planner-plan-b-list,.planner-watch-list{display:grid;gap:.55rem;margin:.85rem 0 0;padding:0;list-style:none}.planner-plan-b-item,.planner-watch-item{display:flex;align-items:center;justify-content:space-between;gap:.6rem;padding:.65rem;border-radius:.55rem;background:#fff;font:.8rem Karla,sans-serif}.planner-plan-b-item strong,.planner-watch-item strong{display:block;color:#172033}.planner-plan-b-item span,.planner-watch-item span{display:block;margin-top:.15rem;color:#667589;font-size:.72rem}.planner-plan-b-item button,.planner-watch-item button,.planner-watch-map-button{border:0;border-radius:.4rem;padding:.38rem .5rem;background:#1d4e89;color:#fff;font:800 .7rem Karla,sans-serif;cursor:pointer}.planner-watch{margin:0 0 1.15rem;padding:0 0 1.15rem;border-bottom:1px solid #edf0f3}.planner-watch .planner-eyebrow{color:#1d4e89}.planner-watch-empty{color:#667589;font:.78rem/1.4 Karla,sans-serif}
  .planner-page{max-width:1440px;margin:0 auto;padding:2rem 1.25rem 3rem;background:#fffaf3;color:#172033}.planner-hero{display:flex;gap:2rem;align-items:flex-end;justify-content:space-between;padding:1.5rem 1.75rem;border-radius:1.25rem;background:linear-gradient(118deg,#102a43,#1d4e89 62%,#f6bd60);color:#fff;box-shadow:0 12px 28px rgba(16,42,67,.18)}.planner-hero h1{margin:.35rem 0 .75rem;font:700 clamp(2rem,5vw,3.4rem)/1 Karla,sans-serif}.planner-eyebrow{margin:0;font:700 .72rem/1 Karla,sans-serif;letter-spacing:.14em}.planner-subtitle{max-width:45rem;margin:0;color:#f5f8fb;line-height:1.55}.planner-actions{display:flex;gap:.75rem;flex-wrap:wrap}.planner-primary,.planner-secondary{border:0;border-radius:.65rem;padding:.85rem 1.1rem;font:700 .95rem Karla,sans-serif;cursor:pointer}.planner-primary{background:#f6bd60;color:#1f2937}.planner-secondary{background:#fff;color:#174577}.planner-status{margin:1rem 0;font:600 .9rem Karla,sans-serif;color:#345}.planner-status[data-state=error]{color:#a22}.planner-status[data-state=success]{color:#166534}.planner-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.8fr);gap:1.25rem}.planner-map-card,.planner-recommendations{overflow:hidden;border:1px solid #e5e7eb;border-radius:1.1rem;background:#fff;box-shadow:0 8px 22px rgba(38,57,77,.09)}.planner-map{height:min(68vh,680px);min-height:430px}.planner-map-note{margin:0;padding:.75rem 1rem;background:#f8fafc;color:#5b6675;font-size:.78rem}.planner-recommendations{padding:1.25rem;align-self:start}.planner-filters{padding-bottom:1.15rem;margin-bottom:1.15rem;border-bottom:1px solid #edf0f3}.planner-filter-heading,.planner-panel-heading{display:flex;align-items:start;justify-content:space-between;gap:1rem}.planner-filter-heading h2,.planner-panel-heading h2{margin:.35rem 0 0;font:700 1.45rem Karla,sans-serif}.planner-filter-heading .planner-eyebrow,.planner-panel-heading .planner-eyebrow{color:#1d4e89}.planner-clear{border:0;background:transparent;color:#174577;font:700 .8rem Karla,sans-serif;text-decoration:underline;cursor:pointer}.planner-filter-options{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.planner-filter input{position:absolute;opacity:0}.planner-filter span{display:block;padding:.45rem .65rem;border:1px solid #d9e1ea;border-radius:999px;color:#405166;font:700 .76rem Karla,sans-serif;cursor:pointer}.planner-filter input:checked+span{border-color:#1d4e89;background:#1d4e89;color:#fff}.planner-pill{padding:.4rem .65rem;border-radius:999px;background:#eef2f7;color:#526170;font:700 .72rem Karla,sans-serif;white-space:nowrap}.planner-pill[data-active=true]{background:#dcfce7;color:#166534}.planner-empty{margin:1.25rem 0;color:#536273;line-height:1.55}.planner-list{display:grid;gap:.85rem;margin:1rem 0;padding:0;list-style:none}.planner-rec{display:grid;grid-template-columns:2rem 1fr;gap:.75rem;padding:.85rem;border:1px solid #e5e7eb;border-radius:.8rem;background:#fffdf9;cursor:pointer}.planner-rank{display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:#1d4e89;color:#fff;font:700 .9rem Karla,sans-serif}.planner-rec a{color:#163a63;font:700 1rem Karla,sans-serif;text-decoration:none}.planner-metrics{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.45rem}.planner-metric{padding:.2rem .45rem;border-radius:.35rem;background:#f1f5f9;color:#405166;font:600 .75rem Karla,sans-serif}.planner-how-it-works{display:grid;gap:.35rem;margin-top:1.25rem;padding:1rem;border-radius:.75rem;background:#fff5df;color:#624c24;font-size:.82rem;line-height:1.45}@@media(max-width:900px){.planner-hero{align-items:start;flex-direction:column}.planner-layout{grid-template-columns:1fr}.planner-recommendations{order:-1}.planner-map{height:55vh;min-height:380px}}@@media(max-width:520px){.planner-page{padding:1rem}.planner-hero{padding:1.25rem}.planner-actions,.planner-primary,.planner-secondary{width:100%}}
  .park-mode[hidden]{display:none}.park-mode{position:fixed;z-index:1000;inset:0;display:grid;place-items:center;padding:clamp(.75rem,3vw,2rem);background:rgba(7,22,39,.72);backdrop-filter:blur(10px);font-family:Karla,Arial,sans-serif}.park-mode-shell{display:grid;width:min(100%,48rem);min-height:min(43rem,calc(100vh - 2rem));overflow:hidden;border-radius:1.35rem;background:radial-gradient(circle at 90% 8%,#3f87b9,transparent 30rem),linear-gradient(145deg,#112f4f,#1c5689);color:#fff;box-shadow:0 28px 72px rgba(0,0,0,.36)}.park-mode-header{display:flex;align-items:center;justify-content:space-between;padding:1.25rem 1.4rem;border-bottom:1px solid rgba(255,255,255,.16)}.park-mode-header>div{display:grid;gap:.25rem}.park-mode-header strong{font-size:.95rem}.park-mode-kicker,.park-mode-overline{margin:0;color:#f8cc75;font:800 .71rem/1 Karla,sans-serif;letter-spacing:.15em}.park-mode-exit{border:1px solid rgba(255,255,255,.32);border-radius:.55rem;background:rgba(255,255,255,.08);padding:.55rem .75rem;color:#fff;font:800 .78rem Karla,sans-serif;cursor:pointer}.park-mode-main{display:flex;flex-direction:column;align-items:center;justify-content:center;max-width:38rem;margin:auto;padding:clamp(2rem,8vw,5rem) clamp(1.25rem,6vw,4rem);text-align:center}.park-mode-sun{display:grid;width:5.25rem;height:5.25rem;place-items:center;border-radius:50%;background:#f8cc75;color:#183e65;font-size:2.8rem;box-shadow:0 0 0 .7rem rgba(248,204,117,.15)}.park-mode-overline{margin-top:2.25rem}.park-mode-main h2{margin:.75rem 0 0;font:800 clamp(2.5rem,7vw,4.65rem)/.94 Karla,sans-serif;letter-spacing:-.065em}.park-mode-reason{max-width:33rem;margin:1.1rem 0 0;color:#e7f1f9;font:500 1.03rem/1.55 Karla,sans-serif}.park-mode-metrics{display:flex;justify-content:center;gap:.6rem;flex-wrap:wrap;margin-top:1.45rem}.park-mode-metrics span{border:1px solid rgba(255,255,255,.16);border-radius:99px;background:rgba(3,18,31,.2);padding:.48rem .68rem;color:#fff;font:800 .82rem Karla,sans-serif}.park-mode-actions{display:flex;justify-content:center;gap:.65rem;flex-wrap:wrap;margin-top:2rem}.park-mode-actions>*{border:0;border-radius:.65rem;padding:.85rem 1rem;font:800 .88rem Karla,sans-serif;text-decoration:none;cursor:pointer}.park-mode-location,.park-mode-go{background:#f8cc75;color:#172033}.park-mode-done{background:#d9f4df;color:#14532d}.park-mode-skip{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.28)}.park-mode-progress{margin:1.65rem 0 0;color:#c7dbea;font:.8rem/1.45 Karla,sans-serif}@@media(max-width:520px){.park-mode{padding:0}.park-mode-shell{min-height:100vh;border-radius:0}.park-mode-main{padding:2.5rem 1.25rem}.park-mode-actions{display:grid;width:100%}.park-mode-actions>*{width:100%;box-sizing:border-box}.park-mode-main h2{font-size:3.1rem}}
  .park-finder[hidden]{display:none}.park-finder{position:fixed;z-index:1001;inset:0;display:grid;place-items:end center;background:rgba(7,22,39,.55);backdrop-filter:blur(5px);font-family:Karla,Arial,sans-serif}.park-finder-sheet{width:min(100%,48rem);max-height:min(52rem,94vh);overflow:auto;border-radius:1.3rem 1.3rem 0 0;background:#fffaf3;color:#172033;box-shadow:0 -12px 42px rgba(0,0,0,.25)}.park-finder-header{display:flex;align-items:flex-start;justify-content:space-between;padding:1.35rem 1.4rem 1rem;border-bottom:1px solid #e5eaf0}.park-finder-header p{margin:0;color:#1d5b90;font:800 .7rem/1 Karla,sans-serif;letter-spacing:.13em}.park-finder-header h2{margin:.45rem 0 0;font:800 clamp(1.8rem,5vw,2.5rem)/1 Karla,sans-serif;letter-spacing:-.05em}.park-finder-header button{border:0;border-radius:50%;width:2.35rem;height:2.35rem;background:#e8f0f6;color:#174577;font-size:1.65rem;line-height:1;cursor:pointer}.park-finder-intro{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.4rem;background:#edf6fc}.park-finder-intro p{margin:0;color:#42556b;font:.86rem/1.45 Karla,sans-serif}.park-finder-intro button{flex:none;border:0;border-radius:.55rem;background:#1d5b90;padding:.62rem .72rem;color:#fff;font:800 .74rem Karla,sans-serif;cursor:pointer}.park-finder-filters{display:flex;gap:.5rem;overflow:auto;padding:1rem 1.4rem .4rem}.park-finder-filters button{white-space:nowrap;border:1px solid #d7e0e9;border-radius:99px;background:#fff;padding:.48rem .68rem;color:#42556b;font:800 .75rem Karla,sans-serif;cursor:pointer}.park-finder-filters button[aria-pressed=true]{border-color:#1d5b90;background:#1d5b90;color:#fff}.park-finder-list{display:grid;gap:.75rem;margin:0;padding:1rem 1.4rem 1.25rem;list-style:none}.park-finder-card{display:grid;grid-template-columns:2.5rem 1fr auto;gap:.75rem;align-items:start;border:1px solid #e1e8ef;border-radius:.8rem;background:#fff;padding:.85rem}.park-finder-icon{display:grid;width:2.5rem;height:2.5rem;place-items:center;border-radius:.65rem;background:#eaf3f8;font-size:1.25rem}.park-finder-card h3{margin:0;font:800 1rem Karla,sans-serif}.park-finder-card p{margin:.25rem 0 0;color:#5f7082;font:.78rem/1.4 Karla,sans-serif}.park-finder-tags{display:flex;flex-wrap:wrap;gap:.3rem;margin-top:.55rem}.park-finder-tags span{border-radius:99px;background:#f0f4f7;padding:.2rem .4rem;color:#526477;font:700 .65rem Karla,sans-serif}.park-finder-distance{display:block;margin-top:.5rem;color:#1b5b90;font:800 .72rem Karla,sans-serif}.park-finder-card a{border-radius:.45rem;background:#e8f0f6;padding:.45rem .55rem;color:#174577;font:800 .7rem Karla,sans-serif;text-decoration:none}.park-finder-empty{margin:1.25rem 1.4rem;color:#5f7082;line-height:1.5}.park-finder-footer{border-top:1px solid #e5eaf0;padding:1rem 1.4rem;color:#6b7b8d;font:.7rem/1.45 Karla,sans-serif}@@media(max-width:520px){.park-finder-sheet{max-height:100vh;border-radius:0}.park-finder-intro{align-items:flex-start;flex-direction:column}.park-finder-card{grid-template-columns:2.5rem 1fr}.park-finder-card a{grid-column:2;justify-self:start}}
</style>

@section Scripts {
  <script>window.parkPlannerConfig = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { parkId = Model.Id, parkName = Model.Name, latitude = Model.Latitude, longitude = Model.Longitude, waitEndpoint = $"/wait-times/{Model.Id}", places = parkPlaces }));</script>
  <script src="/assets/js/map-scripts/park-planner.js?v=park-finder-v1"></script>
  @if (!string.IsNullOrWhiteSpace(apiUrl)) { <script async src="@apiUrl"></script> }
}

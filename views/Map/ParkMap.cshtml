@model ParkGuide
@{ ViewData["Title"] = $"{Model.Name} planner"; var apiUrl = ViewData["MapApiUrl"] as string; }
<main class="planner-page">
  <section class="planner-hero">
    <div>
      <p class="planner-eyebrow">@Model.Name.ToUpperInvariant() &middot; LIVE PLANNER</p>
      <h1>Find your next great ride</h1>
      <p class="planner-subtitle">Share your location to balance walking distance with current standby waits. Your location stays in this browser.</p>
    </div>
    <div class="planner-actions"><button id="share-location" class="planner-primary" type="button">Use my location</button><button id="refresh-waits" class="planner-secondary" type="button">Refresh waits</button></div>
  </section>

  <p id="planner-status" class="planner-status" role="status">Loading live wait times&hellip;</p>
  <section class="planner-layout">
    <div class="planner-map-card"><div id="map" class="planner-map" aria-label="@Model.Name attraction map"></div><p class="planner-map-note">Live wait times are powered by <a href="https://queue-times.com/" target="_blank" rel="noopener">Queue-Times.com</a> and can change at any time.</p></div>
    <aside class="planner-recommendations" aria-live="polite">
      <section class="planner-filters" aria-labelledby="filter-heading">
        <div class="planner-filter-heading"><div><p class="planner-eyebrow">RIDE FILTERS</p><h2 id="filter-heading">What sounds good?</h2></div><button id="clear-filters" class="planner-clear" type="button" hidden>Clear</button></div>
        <div class="planner-filter-options"><label class="planner-filter"><input type="checkbox" value="coaster" /><span>Roller coasters</span></label><label class="planner-filter"><input type="checkbox" value="dark" /><span>Dark rides</span></label><label class="planner-filter"><input type="checkbox" value="family" /><span>Family-friendly</span></label><label class="planner-filter"><input type="checkbox" value="adventure" /><span>Adventure</span></label><label class="planner-filter"><input type="checkbox" value="gentle" /><span>Gentle rides</span></label></div>
      </section>
      <section id="my-day-summary" class="planner-day-summary" hidden><div><p class="planner-eyebrow">YOUR DAY PLAN</p><strong id="my-day-count"></strong></div><a id="edit-my-day" href="/plan">Edit plan</a></section>
      <div class="planner-panel-heading"><div><p class="planner-eyebrow">PERSONAL PICKS</p><h2>Best choices nearby</h2></div><span id="location-state" class="planner-pill">Location off</span></div>
      <p id="recommendation-empty" class="planner-empty">Share your location to see the three best ride choices for where you are right now.</p><ol id="recommendation-list" class="planner-list" hidden></ol>
      <div class="planner-how-it-works"><strong>How it works</strong><span>We prioritize lower waits, then shorter walks. Your location is not saved or sent to our server.</span></div>
    </aside>
  </section>
</main>

<style>
  .planner-day-summary{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:0 0 1.15rem;padding:.85rem 1rem;border-radius:.75rem;background:#eaf4fb;color:#174577}.planner-day-summary .planner-eyebrow{color:#1d4e89;opacity:1}.planner-day-summary strong{display:block;margin-top:.3rem;font:800 .9rem Karla,sans-serif}.planner-day-summary a{color:#174577;font:800 .78rem Karla,sans-serif}.planner-rec-actions{display:flex;gap:.5rem;margin-top:.8rem}.planner-navigate,.planner-done{border:0;border-radius:.42rem;padding:.38rem .55rem;background:#e9f2f8;color:#174577;font:800 .72rem Karla,sans-serif;text-decoration:none;cursor:pointer}.planner-done{background:#e5f4e8;color:#166534}
  .planner-page{max-width:1440px;margin:0 auto;padding:2rem 1.25rem 3rem;background:#fffaf3;color:#172033}.planner-hero{display:flex;gap:2rem;align-items:flex-end;justify-content:space-between;padding:1.5rem 1.75rem;border-radius:1.25rem;background:linear-gradient(118deg,#102a43,#1d4e89 62%,#f6bd60);color:#fff;box-shadow:0 12px 28px rgba(16,42,67,.18)}.planner-hero h1{margin:.35rem 0 .75rem;font:700 clamp(2rem,5vw,3.4rem)/1 Karla,sans-serif}.planner-eyebrow{margin:0;font:700 .72rem/1 Karla,sans-serif;letter-spacing:.14em}.planner-subtitle{max-width:45rem;margin:0;color:#f5f8fb;line-height:1.55}.planner-actions{display:flex;gap:.75rem;flex-wrap:wrap}.planner-primary,.planner-secondary{border:0;border-radius:.65rem;padding:.85rem 1.1rem;font:700 .95rem Karla,sans-serif;cursor:pointer}.planner-primary{background:#f6bd60;color:#1f2937}.planner-secondary{background:#fff;color:#174577}.planner-status{margin:1rem 0;font:600 .9rem Karla,sans-serif;color:#345}.planner-status[data-state=error]{color:#a22}.planner-status[data-state=success]{color:#166534}.planner-layout{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.8fr);gap:1.25rem}.planner-map-card,.planner-recommendations{overflow:hidden;border:1px solid #e5e7eb;border-radius:1.1rem;background:#fff;box-shadow:0 8px 22px rgba(38,57,77,.09)}.planner-map{height:min(68vh,680px);min-height:430px}.planner-map-note{margin:0;padding:.75rem 1rem;background:#f8fafc;color:#5b6675;font-size:.78rem}.planner-recommendations{padding:1.25rem;align-self:start}.planner-filters{padding-bottom:1.15rem;margin-bottom:1.15rem;border-bottom:1px solid #edf0f3}.planner-filter-heading,.planner-panel-heading{display:flex;align-items:start;justify-content:space-between;gap:1rem}.planner-filter-heading h2,.planner-panel-heading h2{margin:.35rem 0 0;font:700 1.45rem Karla,sans-serif}.planner-filter-heading .planner-eyebrow,.planner-panel-heading .planner-eyebrow{color:#1d4e89}.planner-clear{border:0;background:transparent;color:#174577;font:700 .8rem Karla,sans-serif;text-decoration:underline;cursor:pointer}.planner-filter-options{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1rem}.planner-filter input{position:absolute;opacity:0}.planner-filter span{display:block;padding:.45rem .65rem;border:1px solid #d9e1ea;border-radius:999px;color:#405166;font:700 .76rem Karla,sans-serif;cursor:pointer}.planner-filter input:checked+span{border-color:#1d4e89;background:#1d4e89;color:#fff}.planner-pill{padding:.4rem .65rem;border-radius:999px;background:#eef2f7;color:#526170;font:700 .72rem Karla,sans-serif;white-space:nowrap}.planner-pill[data-active=true]{background:#dcfce7;color:#166534}.planner-empty{margin:1.25rem 0;color:#536273;line-height:1.55}.planner-list{display:grid;gap:.85rem;margin:1rem 0;padding:0;list-style:none}.planner-rec{display:grid;grid-template-columns:2rem 1fr;gap:.75rem;padding:.85rem;border:1px solid #e5e7eb;border-radius:.8rem;background:#fffdf9;cursor:pointer}.planner-rank{display:grid;width:2rem;height:2rem;place-items:center;border-radius:50%;background:#1d4e89;color:#fff;font:700 .9rem Karla,sans-serif}.planner-rec a{color:#163a63;font:700 1rem Karla,sans-serif;text-decoration:none}.planner-metrics{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.45rem}.planner-metric{padding:.2rem .45rem;border-radius:.35rem;background:#f1f5f9;color:#405166;font:600 .75rem Karla,sans-serif}.planner-how-it-works{display:grid;gap:.35rem;margin-top:1.25rem;padding:1rem;border-radius:.75rem;background:#fff5df;color:#624c24;font-size:.82rem;line-height:1.45}@@media(max-width:900px){.planner-hero{align-items:start;flex-direction:column}.planner-layout{grid-template-columns:1fr}.planner-recommendations{order:-1}.planner-map{height:55vh;min-height:380px}}@@media(max-width:520px){.planner-page{padding:1rem}.planner-hero{padding:1.25rem}.planner-actions,.planner-primary,.planner-secondary{width:100%}}
</style>

@section Scripts {
  <script>window.parkPlannerConfig = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { parkId = Model.Id, parkName = Model.Name, latitude = Model.Latitude, longitude = Model.Longitude, waitEndpoint = $"/wait-times/{Model.Id}" }));</script>
  <script src="/assets/js/map-scripts/park-planner.js"></script>
  @if (!string.IsNullOrWhiteSpace(apiUrl)) { <script async src="@apiUrl"></script> }
}
